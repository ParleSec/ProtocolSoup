---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/design/tokens.css';
import logoDark from '../assets/wordmark-dark.svg';
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Interactive API reference for all ProtocolSoup services." />
    <meta name="theme-color" content="#a855f7" />
    <title>API Reference | ProtocolSoup</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: var(--ps-bg-base); color: var(--ps-fg); }

      .api-topbar {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.625rem 1.25rem;
        background: var(--ps-bg-base);
        border-bottom: 1px solid var(--ps-bg-overlay);
        font-family: var(--ps-font-mono);
      }

      .api-topbar a {
        color: var(--ps-fg-muted);
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
        transition: color var(--ps-duration-hover);
      }

      .api-topbar a:hover { color: var(--ps-fg); }

      .api-topbar .logo { display: inline-flex; }
      .api-topbar .logo img { height: 1.25rem; width: auto; }

      .api-topbar .sep {
        color: var(--ps-bg-elevated);
        font-size: 0.875rem;
      }

      .api-topbar .title {
        color: var(--ps-fg-subtle);
        font-size: 0.8125rem;
        font-weight: 600;
        font-family: var(--ps-font-mono);
        letter-spacing: -0.01em;
      }

      .api-topbar nav {
        margin-left: auto;
        display: flex;
        gap: 1.25rem;
      }

      .service-tabs {
        display: flex;
        align-items: center;
        gap: 0;
        background: var(--ps-bg-raised);
        border-bottom: 1px solid var(--ps-bg-overlay);
        font-family: var(--ps-font-mono);
        padding: 0 1rem;
      }

      .service-tabs .tab-label {
        color: var(--ps-fg-subtle);
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.625rem 0.75rem;
        white-space: nowrap;
      }

      .service-tabs a {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.625rem 1rem;
        color: var(--ps-fg-muted);
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
        transition: color var(--ps-duration-hover), background var(--ps-duration-hover);
        border-bottom: 2px solid transparent;
        white-space: nowrap;
      }

      .service-tabs a:hover {
        color: var(--ps-fg);
        background: var(--ps-glass);
      }

      .service-tabs a.active {
        color: var(--ps-fg);
        border-bottom-color: var(--ps-brand);
      }

      .service-tabs a .badge {
        display: inline-block;
        font-size: 0.625rem;
        font-weight: 700;
        padding: 0.1rem 0.375rem;
        border-radius: var(--ps-radius-inline);
        line-height: 1.3;
      }

      .service-tabs a .badge.gw { background: var(--ps-glass); color: var(--ps-fg-muted); box-shadow: inset 0 0 0 1px var(--ps-border-default); }
      .service-tabs a .badge.fed { background: color-mix(in srgb, var(--ps-protocol-oauth2) 15%, transparent); color: var(--ps-protocol-oauth2); }
      .service-tabs a .badge.scim { background: color-mix(in srgb, var(--ps-protocol-scim) 15%, transparent); color: var(--ps-protocol-scim); }
      .service-tabs a .badge.vc { background: color-mix(in srgb, var(--ps-protocol-oid4vci) 15%, transparent); color: var(--ps-protocol-oid4vci); }

      #scalar-ref {
        height: calc(100vh - 82px);
      }
    </style>
  </head>
  <body>
    <div class="api-topbar">
      <a href="/" class="logo"><img src={logoDark.src} alt="ProtocolSoup" /></a>
      <span class="sep">/</span>
      <span class="title">API Reference</span>
      <nav>
        <a href="/api/overview/">Guides</a>
        <a href="/api/integration-patterns/">Patterns</a>
        <a href="/">Back to Docs</a>
      </nav>
    </div>

    <div class="service-tabs" id="service-tabs">
      <span class="tab-label">Service</span>
      <a href="#gateway" data-source="gateway" class="active">
        <span class="badge gw">GW</span> Gateway
      </a>
      <a href="#federation" data-source="federation">
        <span class="badge fed">FED</span> Federation
      </a>
      <a href="#scim" data-source="scim">
        <span class="badge scim">SCIM</span> SCIM
      </a>
      <a href="#vc" data-source="vc">
        <span class="badge vc">VC</span> Verifiable Credentials
      </a>
    </div>

    <div id="scalar-ref"></div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@latest"></script>
    <script is:inline>
      var sources = [
        { title: 'Gateway API', slug: 'gateway', url: 'https://docs.protocolsoup.com/openapi/gateway.yaml' },
        { title: 'Federation API', slug: 'federation', url: 'https://docs.protocolsoup.com/openapi/federation.yaml' },
        { title: 'SCIM API', slug: 'scim', url: 'https://docs.protocolsoup.com/openapi/scim.yaml' },
        { title: 'VC API', slug: 'vc', url: 'https://docs.protocolsoup.com/openapi/vc.yaml' },
      ];

      var initialSlug = window.location.hash.replace('#', '') || 'gateway';
      var initialIdx = sources.findIndex(function(s) { return s.slug === initialSlug; });
      if (initialIdx < 0) initialIdx = 0;

      function setActiveTab(slug) {
        document.querySelectorAll('#service-tabs a').forEach(function(a) {
          a.classList.toggle('active', a.dataset.source === slug);
        });
      }

      setActiveTab(sources[initialIdx].slug);

      var scalarInstance = Scalar.createApiReference('#scalar-ref', {
        theme: 'purple',
        darkMode: true,
        hideDownloadButton: false,
        hideTestRequestButton: false,
        proxyUrl: 'https://proxy.scalar.com',
        defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
        sources: sources,
        source: initialIdx,
      });

      document.getElementById('service-tabs').addEventListener('click', function(e) {
        var tab = e.target.closest('a[data-source]');
        if (!tab) return;
        e.preventDefault();
        var slug = tab.dataset.source;
        var idx = sources.findIndex(function(s) { return s.slug === slug; });
        if (idx < 0) return;

        setActiveTab(slug);
        window.location.hash = slug;

        if (scalarInstance && scalarInstance.updateSource) {
          scalarInstance.updateSource(idx);
        } else if (scalarInstance && scalarInstance.update) {
          scalarInstance.update({ source: idx });
        } else {
          document.getElementById('scalar-ref').innerHTML = '';
          scalarInstance = Scalar.createApiReference('#scalar-ref', {
            theme: 'purple',
            darkMode: true,
            hideDownloadButton: false,
            hideTestRequestButton: false,
            proxyUrl: 'https://proxy.scalar.com',
            defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
            sources: sources,
            source: idx,
          });
        }
      });

      window.addEventListener('hashchange', function() {
        var slug = window.location.hash.replace('#', '');
        var idx = sources.findIndex(function(s) { return s.slug === slug; });
        if (idx >= 0) setActiveTab(slug);
      });
    </script>
  </body>
</html>
