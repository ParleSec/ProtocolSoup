# Build stage: server binary + palette-indexer + deterministic palette.db.
# It runs on the build platform and cross-compiles the server for the target
# platform, so a multi-platform build never runs the Go compiler under
# emulation. The indexer is built for and run on the build platform:
# palette.db is the same file on every architecture.
FROM --platform=$BUILDPLATFORM golang:1.27.0-alpine AS builder

ARG SERVICE_CMD=./cmd/server
ARG TARGETARCH

WORKDIR /app

RUN apk add --no-cache file

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .
COPY content/ /content/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o server ${SERVICE_CMD}
RUN CGO_ENABLED=0 go build -o palette-indexer ./cmd/palette-indexer
RUN ./palette-indexer -content /content -registry /app/internal/conformance/vc-requirements.yaml -out /app/palette.db && \
    test -s /app/palette.db && \
    file /app/palette.db | grep -q SQLite

# Runtime stage
FROM alpine:3.24

WORKDIR /app

RUN apk --no-cache add ca-certificates

COPY --from=builder /app/server .
COPY --from=builder /app/palette.db ./palette.db

EXPOSE 8080

ENV SHOWCASE_ENV=demo
ENV SHOWCASE_LISTEN_ADDR=:8080
ENV SHOWCASE_BASE_URL=http://localhost:8080
ENV SHOWCASE_MOCK_IDP=true
ENV SHOWCASE_PALETTE_DB=/app/palette.db

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./server"]
